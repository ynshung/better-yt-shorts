{
  "name": "better-yt-shorts",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently --kill-others \"sass --watch src/css\" \"vite\"",
    "build": "sass src/css && tsc && vite build",
    "preview": "vite preview",
    "dev:firefox": "node scripts/firefox-watch.js",
    "build:firefox": "node scripts/firefox-build-manifest.js",
    "lint": "eslint src",
    "format": "prettier . --write"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.9",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
